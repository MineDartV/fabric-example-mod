plugins {
    id 'fabric-loom' version '1.10.5' apply false
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(21)
    }
}

apply plugin: 'fabric-loom'

version = '1.0.0'
group = 'com.example'

repositories {
    maven {
        url 'https://maven.fabricmc.net/'
    }
    mavenCentral()
}

dependencies {
    minecraft 'com.mojang:minecraft:1.21.5'
    mappings 'net.fabricmc:yarn:1.21.5+build.1:v2'
    modImplementation 'net.fabricmc:fabric-loader:0.16.10'
    modImplementation 'net.fabricmc.fabric-api:fabric-api:0.119.2+1.21.5'
    annotationProcessor 'org.spongepowered:mixin:0.8.5:processor'
}

java {
    withSourcesJar()
}

jar {
    from('LICENSE') {
        rename 'LICENSE', 'LICENSE_${project.name}'
    }
}

processResources {
    inputs.property 'version', project.version
    
    filesMatching('fabric.mod.json') {
        expand 'version': project.version
    }
    
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
    
    from(sourceSets.main.resources.srcDirs) {
        include 'fabric.mod.json'
        include 'javamod01.accesswidener'
        include 'javamod01.client.mixins.json'
        include 'assets/javamod01/**'
    }
}

tasks.withType(JavaCompile) {
    options.encoding = 'UTF-8'
}
